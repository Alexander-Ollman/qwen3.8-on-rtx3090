# Copy to .env and edit. Never commit .env.
VLLM_API_KEY=CHANGE_ME    # openssl rand -hex 24
REPO_DIR=./qwen38-rtx3090
LB_PORT=18000

# ---- Per-replica config. This is the A/B surface. ----
# SPEC: empty = Qwen's built-in MTP (k=4) | dflash2 = DFlash2 block drafter (k=7)
# CTX:  fast (bf16 KV, 64K) | long (fp8 KV, 150K) | huge (KVarN 4/2-bit, ~200K)
# PREFIX_CACHE: 0 for clean benchmarking, 1 for production chat/RAG (big TTFT win
#               on repeat turns — the repo reports 23 s -> 1 s on a 24K document).
GPU0_SPEC=
GPU0_CTX=fast
GPU0_PREFIX_CACHE=0

GPU1_SPEC=
GPU1_CTX=fast
GPU1_PREFIX_CACHE=0
